{
    "name":  "Cline Agent Mobile - Bridge",
    "image":  "mcr.microsoft.com/devcontainers/javascript-node:1-18-bullseye",
    "forwardPorts":  [
                         3000
                     ],
    "portsAttributes":  {
                            "3000":  {
                                         "label":  "Cline Bridge",
                                         "onAutoForward":  "silent"
                                     }
                        },
    "postCreateCommand":  "cd bridge \u0026\u0026 npm install",
    "postStartCommand":  "cd bridge \u0026\u0026 (npm install --no-audit --no-fund || true) \u0026\u0026 nohup node server.js \u003e /tmp/cline-bridge.log 2\u003e\u00261 \u0026 sh bridge/configure-public-port.sh",
    "features":  {
                     "ghcr.io/devcontainers/features/github-cli:1":  {

                                                                     },
                     "ghcr.io/devcontainers/features/sshd:1":  {
                                                                   "version":  "latest"
                                                               }
                 }
}
